from mcp.server.fastmcp import FastMCP
 
mcp = FastMCP(
    name="PantryInventoryMCP",
    host="0.0.0.0",
    port=8000
)
 
PANTRY_STOCK = {
    "tea powder": {"quantity": 2, "unit": "kg", "status": "Available"},
    "coffee powder": {"quantity": 1.5, "unit": "kg", "status": "Available"},
    "sugar": {"quantity": 5, "unit": "kg", "status": "Available"},
    "paper cups": {"quantity": 20, "unit": "pieces", "status": "Low stock"},
    "water bottles": {"quantity": 48, "unit": "bottles", "status": "Available"},
}
 
@mcp.tool()
def check_pantry_stock(item_name: str) -> dict:
    """
    Check pantry stock for a given item name.
    Use this tool when the user asks whether an office pantry item is available.
    """
    item = item_name.strip().lower()
 
    if item not in PANTRY_STOCK:
        return {
            "item_name": item_name,
            "found": False,
            "message": "Item not found in pantry stock list."
        }
 
    stock = PANTRY_STOCK[item]
 
    return {
        "item_name": item_name,
        "found": True,
        "available_quantity": stock["quantity"],
        "unit": stock["unit"],
        "status": stock["status"],
        "last_updated": "Demo data"
    }
 
if __name__ == "__main__":
    mcp.run(transport="streamable-http")
    
    
    
